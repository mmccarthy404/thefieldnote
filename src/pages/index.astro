---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getPublishedPosts, postPath } from '../lib/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<Header />
		<main id="content" class="wrap">
			<h1 class="sr-only">{SITE_TITLE}</h1>
			{
				posts.length === 0 ? (
					<p class="empty">No posts.</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={postPath(post)}>
									<p class="post-list-date">
										<FormattedDate date={post.data.pubDate} />
										{post.data.draft && <span class="post-list-draft"> · Draft</span>}
									</p>
									<h2 class="post-list-title">{post.data.title}</h2>
									<p class="post-list-desc">{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
