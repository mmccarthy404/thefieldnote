---
import { SITE_TAGLINE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-head">
	<div class="wrap site-head-inner">
		<div>
			<a class="site-title" href="/">{SITE_TITLE}</a>
			{/* Renders nothing until a tagline is written; see consts.ts. */}
			{SITE_TAGLINE && <span class="site-tagline">{SITE_TAGLINE}</span>}
		</div>
		<nav class="site-nav" aria-label="Main">
			<HeaderLink href="/">Posts</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</header>
