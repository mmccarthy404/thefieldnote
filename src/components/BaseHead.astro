---
// Imported here so every page that renders <BaseHead /> gets the stylesheet.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	/** Set on posts that were first published elsewhere. */
	canonicalUrl?: string;
	type?: 'website' | 'article';
}

const {
	title,
	description = SITE_DESCRIPTION,
	image,
	canonicalUrl,
	type = 'website',
} = Astro.props;

// A post's own canonicalUrl wins, so cross-posted pieces point at the original.
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;

// Titles read "Post title · The Field Note", except on the home page.
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" sizes="any" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
{/* The feed's only surface. There is no visible RSS link: a naked link to
    raw XML reads as a broken page to anyone who does not already know what
    a feed is. Readers autodiscover via this tag. */}
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-plex-sans" preload />
<Font cssVariable="--font-jetbrains-mono" />

<link rel="canonical" href={canonical} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.site)} />}
